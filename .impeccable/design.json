      "html": "<section class=\"ds-panel\"><h3 class=\"ds-panel-title\">Your wallets</h3><p class=\"ds-panel-copy\">Opening balances and recorded transactions stay together.</p></section>",
      "css": ".ds-panel{font-family:Inter,sans-serif;font-variant-numeric:tabular-nums;padding:20px;border:1px solid #DCDDDC;border-radius:14px;background:#FFFEFB;color:#242938}.ds-panel-title{margin:0 0 8px;font-size:16px;font-weight:600;letter-spacing:-.25px}.ds-panel-copy{margin:0;font-size:14px;font-weight:400;line-height:1.5}"
